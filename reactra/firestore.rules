rules_version = '2';

// ============================================================
// Deploy with: firebase deploy --only firestore:rules
// (after running `firebase init` and selecting this project)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() == "admin";
    }

    function isEvaluator() {
      return isSignedIn() && role() == "evaluator";
    }

    // True if the caller is an evaluator assigned to judge this specific team.
    function isAssignedEvaluator(teamId) {
      let team = get(/databases/$(database)/documents/teams/$(teamId)).data;
      return "assignedEvaluatorIds" in team &&
        team.assignedEvaluatorIds is list &&
        team.assignedEvaluatorIds.hasAny([request.auth.uid]);
    }

    // ---------------- users ----------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      // Only admins can change someone's role after creation.
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------------- announcements ----------------
    match /announcements/{id} {
      allow read: if true; // public, even logged-out visitors can see announcements
      allow write: if isAdmin();
    }

    // ---------------- teams ----------------
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      // Admins can update anything. The student who created the team can ONLY
      // update their upload URLs — not round1Status, definition, or evaluator
      // assignments, even by calling Firestore directly.
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pptUrl", "docUrl"])
      );
      allow delete: if isAdmin();
    }

    // ---------------- definitions ----------------
    match /definitions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---------------- scores ----------------
    match /scores/{id} {
      allow read: if isSignedIn();
      allow create: if isEvaluator()
        && request.resource.data.evaluatorId == request.auth.uid
        && isAssignedEvaluator(request.resource.data.teamId);
      allow update, delete: if (isEvaluator() && resource.data.evaluatorId == request.auth.uid) || isAdmin();
    }

    // ---------------- eventConfig ----------------
    match /eventConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------- seating ----------------
    match /seating/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
